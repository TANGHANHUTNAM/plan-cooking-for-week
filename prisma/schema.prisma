generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum FoodType {
  MAIN
  SIDE
}

enum MealPeriod {
  LUNCH
  DINNER
}

/// Why a week plan was replaced — shown as the label of a history entry
enum PlanSnapshotReason {
  RANDOM_WEEK
  COPY_LAST_WEEK
  RESTORE
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  name         String
  passwordHash String
  createdAt    DateTime      @default(now())
  absences     MealAbsence[]

  @@map("users")
}

/// One row represents an ingredient bought for the week, shared by the household.
model ShoppingIngredientCheck {
  id            String   @id @default(cuid())
  weekStart     DateTime @db.Date
  ingredientKey String
  createdAt     DateTime @default(now())

  @@unique([weekStart, ingredientKey])
  @@index([weekStart])
  @@map("shopping_ingredient_checks")
}

/// Extra items for a given day, shared by the household.
model ShoppingExtra {
  id        String   @id @default(cuid())
  date      DateTime @db.Date
  name      String
  purchased Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
  @@map("shopping_extras")
}

model Food {
  id            String         @id @default(cuid())
  name          String
  type          FoodType
  cookingMethod String
  note          String?
  favoriteScore Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  ingredients   Ingredient[]
  mealItems     MealItem[]
  statistic     FoodStatistic?

  @@map("foods")
}

model Ingredient {
  id     String @id @default(cuid())
  foodId String
  name   String
  food   Food   @relation(fields: [foodId], references: [id], onDelete: Cascade)

  @@map("ingredients")
}

model MealPlan {
  id        String   @id @default(cuid())
  weekStart DateTime @db.Date
  createdAt DateTime @default(now())
  meals     Meal[]

  // The meal plan belongs to the household, not its creator,
  // so deleting an account does not affect the weekly plan
  @@unique([weekStart])
  @@map("meal_plans")
}

/// A full copy of one week's plan, saved right before it is overwritten,
/// so the household can undo a mis-tapped "Random tuần" and read past menus.
model PlanSnapshot {
  id        String             @id @default(cuid())
  weekStart DateTime           @db.Date
  reason    PlanSnapshotReason
  /// Number of meals in the snapshot, so the history list stays readable even if `data` cannot be parsed
  mealCount Int
  /// Meals with dishes, notes, cooked state and absences; dish names are stored too
  /// so history survives a food being renamed or deleted
  data      Json
  createdAt DateTime           @default(now())

  @@index([weekStart, createdAt])
  @@map("plan_snapshots")
}

model Meal {
  id         String        @id @default(cuid())
  mealPlanId String
  date       DateTime      @db.Date
  period     MealPeriod
  cookedAt   DateTime?
  /// A household note for this meal (e.g. missing fish sauce), also shown on the Shopping tab
  note       String?
  mealPlan   MealPlan      @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)
  items      MealItem[]
  absences   MealAbsence[]

  @@unique([mealPlanId, date, period])
  @@map("meals")
}

/// One row represents a member who does NOT eat the meal (everyone eats by default)
model MealAbsence {
  id     String @id @default(cuid())
  mealId String
  userId String
  meal   Meal   @relation(fields: [mealId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([mealId, userId])
  @@map("meal_absences")
}

model MealItem {
  id       String   @id @default(cuid())
  mealId   String
  foodId   String
  position FoodType
  meal     Meal     @relation(fields: [mealId], references: [id], onDelete: Cascade)
  food     Food     @relation(fields: [foodId], references: [id], onDelete: Cascade)

  @@unique([mealId, position])
  @@map("meal_items")
}

model FoodStatistic {
  id           String    @id @default(cuid())
  foodId       String    @unique
  totalCooked  Int       @default(0)
  lastCookedAt DateTime?
  food         Food      @relation(fields: [foodId], references: [id], onDelete: Cascade)

  @@map("food_statistics")
}
